NODE_ENV=development
DATABASE_URL=postgres://rakazo:rakazo@127.0.0.1:5433/rakazo
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret
BETTER_AUTH_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:3100
WEB_ORIGIN=http://127.0.0.1:5173
SIGNUPS_ENABLED=true
SIGNUP_ALLOWLIST=
ENCRYPTION_KEY=replace-with-64-char-hex-or-passphrase
DATA_DIR=./data
SANDBOX_SUPERVISOR_URL=http://127.0.0.1:7091
# Optional separate service credential; defaults to BETTER_AUTH_SECRET when empty.
SANDBOX_SUPERVISOR_TOKEN=
SANDBOX_PROVIDER=docker
AGENT_RUNTIME=pi
WAKEUP_DRIVER=graphile
# Pause E2B (or stop Docker) computers after this many idle ms. Minimum 30000.
SANDBOX_IDLE_MS=600000
OPENROUTER_API_KEY=
# To use Devin as the agent runtime, set AGENT_RUNTIME=devin and provide:
# DEVIN_API_KEY=cog_your_key_here
# DEVIN_ORG_ID=org-your_org_id_here
# To use the Devin CLI (free GLM-5.2 model), set AGENT_RUNTIME=devin-cli and provide:
# DEVIN_CLI_PATH=/Applications/Devin.app/Contents/Resources/app/extensions/windsurf/devin/bin/devin
# DEVIN_MODEL=glm-5-2
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_MODEL=glm-5-2
DEVIN_CLI_PATH=
PI_DEFAULT_PROVIDER=openrouter
PI_DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731
E2B_API_KEY=
COMPOSIO_API_KEY=
SMTP_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
