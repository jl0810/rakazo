{
  "mcpServers": {
    "dokploy": {
      "command": "/usr/local/bin/node",
      "args": ["/opt/dokploy-mcp/build/index.js"],
      "env": {
        "DOKPLOY_API_KEY": "${DOKPLOY_API_KEY}",
        "DOKPLOY_URL": "${DOKPLOY_URL}"
      },
      "disabledTools": [
        "project-create",
        "project-update",
        "project-duplicate",
        "project-remove",
        "application-create",
        "application-delete",
        "application-move",
        "application-cancelDeployment",
        "application-reload",
        "application-markRunning",
        "application-saveBuildType",
        "application-saveGithubProvider",
        "application-saveGitlabProvider",
        "application-saveBitbucketProvider",
        "application-saveGiteaProvider",
        "application-saveGitProvider",
        "application-saveDockerProvider",
        "application-disconnectGitProvider",
        "application-updateTraefikConfig",
        "application-refreshToken",
        "application-cleanQueues",
        "domain-byComposeId",
        "domain-one",
        "domain-create",
        "domain-update",
        "domain-delete",
        "domain-validateDomain",
        "domain-generateDomain",
        "domain-canGenerateTraefikMeDomains",
        "postgres-create",
        "postgres-update",
        "postgres-remove",
        "postgres-move",
        "postgres-reload",
        "postgres-rebuild",
        "postgres-changeStatus",
        "mysql-create",
        "mysql-one",
        "mysql-update",
        "mysql-remove",
        "mysql-move",
        "mysql-deploy",
        "mysql-start",
        "mysql-stop",
        "mysql-reload",
        "mysql-rebuild",
        "mysql-changeStatus",
        "mysql-saveExternalPort",
        "mysql-saveEnvironment",
        "compose-create",
        "compose-remove"
      ]
    },
    "postgres": {
      "command": "/root/.local/bin/uvx",
      "args": [
        "--python",
        "3.13",
        "postgres-mcp",
        "--access-mode=unrestricted",
        "${POSTGRES_MCP_URL_MAIN}"
      ]
    },
    "postgres-trade": {
      "command": "/root/.local/bin/uvx",
      "args": [
        "--python",
        "3.13",
        "postgres-mcp",
        "--access-mode=unrestricted",
        "${POSTGRES_MCP_URL_TRADE}"
      ]
    },
    "postgres-etf": {
      "command": "/root/.local/bin/uvx",
      "args": [
        "--python",
        "3.13",
        "postgres-mcp",
        "--access-mode=unrestricted",
        "${POSTGRES_MCP_URL_ETF}"
      ]
    },
    "rakazo-connectors": {
      "command": "/usr/local/bin/node",
      "args": ["/app/packages/adapters/src/rakazo-mcp-wrapper.mjs"],
      "env": {
        "RAKAZO_MCP_SESSION_FILE": "/tmp/rakazo-mcp-session-placeholder.json"
      }
    }
  }
}
